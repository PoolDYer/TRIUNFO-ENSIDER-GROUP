# Producción: Supabase > Connect > Transaction pooler (puerto 6543).
# Copiar el host exacto; usuario postgres.REFERENCIA y base postgres.
# DATABASE_URL=postgresql://postgres.REFERENCIA:CLAVE@HOST.pooler.supabase.com:6543/postgres?sslmode=require
# Para preparar el esquema usar Session pooler (5432), en .env.supabase.local.
DATABASE_URL=postgresql://usuario:clave@host:5432/triunfo?sslmode=require
# Si Supabase requiere su CA, usar el contenido PEM del certificado oficial.
# En Vercel pegar el contenido completo como variable privada multilínea.
DATABASE_SSL_CA=
# Opcional: origen exacto del despliegue, sin barra final.
# APP_URL=https://tu-proyecto.vercel.app
# Solo desarrollo local; nunca habilitar en Vercel.
LOCAL_DATABASE=false
# Configurar solo al ejecutar npm run db:setup; mínimo 12 caracteres.
INITIAL_ADMIN_PASSWORD=
INITIAL_SELLER_1_PASSWORD=
INITIAL_SELLER_2_PASSWORD=
INITIAL_SELLER_3_PASSWORD=
# Exportación a Google Sheets (cliente OAuth de tipo Aplicación web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/google/callback
# Clave aleatoria de 32 bytes, codificada en base64. No cambiar entre despliegues.
GOOGLE_TOKEN_ENCRYPTION_KEY=
